{
  "datasets": [
    {
      "name": "17232abf",
      "displayName": "bot_swarm_alerts",
      "config": {
        "version": "1.1",
        "source": "aegis.gold.bot_swarm_alerts",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "2ed3d122",
      "displayName": "account_velocity_alerts",
      "queryLines": [
        "SELECT\r\n",
        "  window_start,\r\n",
        "  user_id,\r\n",
        "  total_interactions,\r\n",
        "  distinct_posts,\r\n",
        "  ROUND(trust_score, 2) AS trust_score,\r\n",
        "  interaction_types\r\n",
        "FROM aegis.gold.account_velocity_alerts\r\n",
        "ORDER BY window_start DESC, total_interactions DESC\r\n",
        "LIMIT 20;"
      ]
    },
    {
      "name": "5fc1d5ff",
      "displayName": "user_profiles",
      "queryLines": [
        "SELECT\r\n",
        "  COUNT(*) AS mitigated_accounts,\r\n",
        "  SUM(CASE WHEN trust_score = 0.0 THEN 1 ELSE 0 END) AS zero_trust_bots\r\n",
        "FROM aegis.silver.user_profiles\r\n",
        "WHERE trust_score <= 0.1;"
      ]
    },
    {
      "name": "ebf8fafe",
      "displayName": "telemetry_quarantined",
      "queryLines": [
        "SELECT\r\n",
        "  CASE\r\n",
        "    WHEN COUNT(*) = 0 THEN 'CLEAN_STREAM'\r\n",
        "    ELSE 'QUARANTINED_EVENTS'\r\n",
        "  END AS status,\r\n",
        "  COUNT(*) AS quarantined_records\r\n",
        "FROM aegis.silver.telemetry_quarantine;"
      ]
    },
    {
      "name": "b4f6aead",
      "displayName": "threat_timeline",
      "queryLines": [
        "SELECT window_start, 'Bot Swarm' AS threat_type, COUNT(*) AS alert_count\r\n",
        "FROM aegis.gold.bot_swarm_alerts\r\n",
        "GROUP BY window_start\r\n",
        "UNION ALL\r\n",
        "SELECT window_start, 'Account Velocity' AS threat_type, COUNT(*) AS alert_count\r\n",
        "FROM aegis.gold.account_velocity_alerts\r\n",
        "GROUP BY window_start\r\n",
        "ORDER BY window_start DESC;"
      ]
    }
  ],
